#include <windows.h>

1 24 "techdraw.manifest"
101 ICON "techdraw.ico"

1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Technical Drawing\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "InternalName", "TechDraw\0"
            VALUE "OriginalFilename", "TechDraw.exe\0"
            VALUE "ProductName", "TechDraw\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
